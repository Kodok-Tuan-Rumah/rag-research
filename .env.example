# ═══════════════════════════════════════════════════════════════════════
# RAG Research — Environment Configuration (Standalone Mode)
# ═══════════════════════════════════════════════════════════════════════
# For Docker Mode A (workspace root), use root .env instead.
# This file is for standalone development only.
# ═══════════════════════════════════════════════════════════════════════

# ── API ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── LLM Provider ──────────────────────────────────────────────────────
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=gsk_your_actual_key_here
LLM_PROVIDER=groq

# ── Qdrant ────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── Confidence Calibration ─────────────────────────────────────────────
CALIBRATION_METHOD=isotonic
CALIBRATION_MODEL_PATH=models/calibration_isotonic.joblib

# ── Redis Cache (Opt-in) ──────────────────────────────────────────────
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ── Tracing ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=rag-research