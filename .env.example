# ═══════════════════════════════════════════════════════════════════════════════════════
# RAG Research — Environment Configuration (Mode B: Standalone)
# ═══════════════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Set GROQ_API_KEY with your actual key (REQUIRED for generation)
# 3. Adjust other values as needed for your environment
# 4. NEVER commit .env — it contains secrets and is gitignored
#
# USAGE:
# - This file is for Mode B (standalone development)
# - For Docker Mode A (workspace root), use root .env instead
# - All services run on localhost with standard ports
#
# ═══════════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 1: API SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 2: LLM PROVIDER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
# Provider selection: "groq" (cloud, fast) | "ollama" (local, RAM-heavy)
LLM_PROVIDER=groq

# Groq configuration (cloud provider)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=gsk_your_actual_key_here

# Ollama configuration (local provider - optional)
# OLLAMA_MODEL=phi3:mini
# OLLAMA_KEEP_ALIVE=0

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 3: VECTOR DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 4: CONFIDENCE CALIBRATION
# ─────────────────────────────────────────────────────────────────────────────────────
CALIBRATION_METHOD=isotonic
CALIBRATION_MODEL_PATH=models/calibration_isotonic.joblib

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 5: REDIS CACHE (Opt-in)
# ─────────────────────────────────────────────────────────────────────────────────────
# Enable for caching RAG results (requires Redis running on localhost)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 6: OPENTELEMETRY TRACING (Optional)
# ─────────────────────────────────────────────────────────────────────────────────────
# Enable distributed tracing for debugging and observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=rag-research
# ═══════════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 7: OPTIONAL RERANKER & INFERENCE SERVICE (OFF BY DEFAULT)
# ─────────────────────────────────────────────────────────────────────────────────────
# Cross-encoder reranking is opt-in; default path is RRF-only.
# USE_RERANKER=false
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
#
# Rust ONNX inference service (optional, default local Python).
# INFERENCE_BACKEND=local   # local | service | shadow
# INFERENCE_SERVICE_URL=http://127.0.0.1:8081
# INFERENCE_REQUIRED=false