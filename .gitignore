# =============================================================================
# Local Vector Database (Never Commit)
# =============================================================================
# Written without a trailing slash on purpose: `git check-ignore` only honours
# a trailing-slash pattern for a directory that already exists on disk, so the
# pattern must match the bare path too.
data/qdrant_storage

# =============================================================================
# Retrieval Indexes & Cached Artifacts
# =============================================================================
data/processed/index_minilm/
data/processed/index_bm25/

# Generated corpus & evaluation data — do NOT commit large JSON artifacts.
# These are regenerated by the ingestion pipeline (scripts/unify_corpus.py,
# scripts/fit_calibration.py) or downloaded at build time. Storing them in git
# bloats the repository; use git LFS or an artifact registry for large binaries.
data/processed/*.json
data/evaluation/*.json
data/debug/*.json
data/adversarial/*.json

# EXCEPTION: Build-critical inputs that MUST be tracked for Docker build.
# The Dockerfile COPYs these files; without them the image build fails.
# See P0-4: build independence.
!data/processed/chunks_semantic_v3.json
!data/evaluation/calibration_dataset.json

# EXCEPTION: Corpus manifest is a build-critical input (read at import time by
# src/retrieval/corpus_manifest.py). Must be tracked for Docker build.
!data/processed/corpus_manifest.json

# Generated model artifacts — calibration report and other metrics are
# produced by scripts/fit_calibration.py at build time, not source.
models/calibration_report.json

# =============================================================================
# Generated Results (evaluation outputs, not source)
# =============================================================================
results/debug/
results/logs/
results/metrics/*.json
results/metrics/*.md
results/eval_phase2_results.json
results/retrieval_eval.json
results/metrics/eval_phase2_*.json

# =============================================================================
# Optional Local Models / Checkpoints
# (Uncomment if needed)
# =============================================================================
# models/
# checkpoints/
# *.pt
# *.pth
# *.bin
# *.pkl

# =============================================================================
# Raw Data & Binaries (Tambahan Penting)
# =============================================================================
# data/raw/ holds the source papers. Ignored on purpose: ~7 PDFs, tens of MB.
# Consequence: chunks_semantic*.json cannot be regenerated from a fresh clone,
# which is why the processed JSON above IS committed. See the note there.
# Bare `data/raw` (no trailing slash) so `git check-ignore data/raw` matches too.
data/raw
*.zip

# =============================================================================
# Evaluasi, Figur, & Log Tambahan
# =============================================================================
*.log
results/failure_cases/
results/figures/

# =============================================================================
# External Tools & Binaries
# =============================================================================
kirocli/
.aider*
.zai/
hf-cache/

# Generated model artifacts
models/*.onnx

# Build/runtime artifacts (do not commit)
models/*.json
services/inference/target/
services/inference/models/

models/*.data
models/vocab.txt
models/special_tokens_map.json
models/tokenizer*.json
models/tokenizer_config.json
models/config.json

# =============================================================================
# Research artifacts & dead code (keep in git history via tags, not main)
# =============================================================================
archive/
decision_unused.py

# =============================================================================
# Confidence/calibration experiment outputs (generated, not source)
# =============================================================================
results/metrics/p0_*.json
results/metrics/p0_*.md
results/metrics/*_before.json
results/metrics/*_sweep.md
results/metrics/reranker_benchmark.json
results/metrics/confidence_gate_diagnosis.json

# =============================================================================
